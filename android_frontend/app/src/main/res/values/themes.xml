<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Use MaterialComponents (AppCompat/Material 1.x) to ensure compatibility with provided dependencies -->
    <style name="Theme.OceanProfessional" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/ocean_primary</item>
        <item name="colorPrimaryVariant">@color/ocean_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/ocean_secondary</item>
        <item name="colorSecondaryVariant">@color/ocean_secondary</item>
        <item name="colorError">@color/ocean_error</item>

        <item name="android:statusBarColor">@color/ocean_primary</item>
        <item name="android:navigationBarColor">@color/ocean_background</item>
        <item name="android:windowBackground">@color/ocean_background</item>
        <item name="android:textColor">@color/ocean_text</item>
        <item name="android:fontFamily">sans-serif</item>

        <!-- Default widget styles -->
        <item name="materialButtonStyle">@style/Widget.Ocean.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Ocean.Card</item>
        <item name="toolbarStyle">@style/Widget.Ocean.Toolbar</item>
    </style>

    <!-- Base rounded shape for references that use Shape.Rounded -->
    <style name="Shape.Rounded">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <!-- Some resources or libraries may reference a base 'Shape' style.
         Provide an alias that maps to the rounded base to avoid AAPT link errors. -->
    <style name="Shape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <!-- Rounded shapes -->
    <style name="Shape.Rounded.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Shape.Rounded.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Ocean widgets -->
    <style name="Widget.Ocean.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:insetTop">8dp</item>
        <item name="android:insetBottom">8dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/ocean_secondary</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="Widget.Ocean.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="Widget.Ocean.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/ocean_primary</item>
        <item name="titleTextColor">@android:color/white</item>
        <item name="subtitleTextColor">@android:color/white</item>
    </style>
</resources>
